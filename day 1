<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PVR Header Component</title>
    <!-- Tailwind CSS for modern, rapid styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter for premium typography -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #09090b; /* Zinc 950 Dark Background */
        }
    </style>
</head>
<body class="text-zinc-100">

    <!-- Top Navigation Bar -->
    <header class="bg-zinc-950/90 backdrop-blur-md border-b border-zinc-800/80 py-4 px-6 sticky top-0 z-50 transition-all">
        <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
            
            <!-- Left Side: Brand Logo and Location Selector -->
            <div class="flex items-center space-x-6">
                <!-- PVR Premium Gold Logo -->
                <div class="flex items-center space-x-3 cursor-pointer group">
                    <span class="bg-gradient-to-r from-amber-500 to-amber-600 text-black px-4 py-1.5 rounded-lg font-black tracking-widest text-lg shadow-md shadow-amber-500/20 group-hover:scale-105 transition-transform duration-300">
                        PVR
                    </span>
                    <span class="text-xs tracking-widest uppercase font-extrabold text-zinc-400 hidden sm:inline-block">CINEMAS</span>
                </div>

                <!-- Location dropdown -->
                <div class="relative hidden md:block">
                    <button class="text-xs text-zinc-300 hover:text-white bg-zinc-900/80 hover:bg-zinc-900 px-4 py-2 rounded-full border border-zinc-800 flex items-center space-x-2 transition-all cursor-pointer">
                        <i class="fa-solid fa-location-dot text-amber-500"></i>
                        <span class="font-semibold">Ahmedabad</span>
                        <i class="fa-solid fa-chevron-down text-[10px] text-zinc-500"></i>
                    </button>
                </div>
            </div>

            <!-- Middle Side: Search Bar (Hidden on Mobile) -->
            <div class="hidden lg:flex flex-grow max-w-md mx-6">
                <div class="relative w-full">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                        <i class="fa-solid fa-magnifying-glass text-zinc-500 text-sm"></i>
                    </span>
                    <input type="text" placeholder="Search for Movies, Theatres or Events..." class="w-full bg-zinc-900/60 text-zinc-200 text-xs pl-10 pr-4 py-2.5 rounded-xl border border-zinc-800 focus:border-amber-500/50 focus:outline-none focus:ring-1 focus:ring-amber-500/50 transition-all placeholder-zinc-500">
                </div>
            </div>

            <!-- Right Side: Navigation Links & Mobile Menu Toggle -->
            <div class="flex items-center space-x-4">
                <!-- Navigation Tabs (Desktop only) -->
                <nav class="hidden md:flex items-center space-x-1 text-xs font-semibold text-zinc-300">
                    <a href="#" class="px-3 py-2 text-amber-500 hover:text-amber-400 transition-colors">Movies</a>
                    <a href="#" class="px-3 py-2 hover:text-white transition-colors">Showtimes</a>
                    <a href="#" class="px-3 py-2 hover:text-white transition-colors">Offers</a>
                </nav>

                <!-- Profile Action Button -->
                <button class="bg-zinc-900 hover:bg-zinc-800 text-zinc-100 hover:text-amber-500 border border-zinc-800 p-2 rounded-xl text-sm transition-all flex items-center justify-center cursor-pointer">
                    <i class="fa-regular fa-user mr-1.5 sm:mr-0 md:mr-1.5"></i>
                    <span class="text-xs font-semibold hidden md:inline">Sign In</span>
                </button>
            </div>

        </div>
    </header>

</body>
</html>
